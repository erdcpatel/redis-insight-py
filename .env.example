# ==========================================
# Redis Insight Py - Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your environment secrets:
#   cp .env.example .env
#
# These variables can be referenced in config/connections.yaml using:
#   password: "${DEV_REDIS_PASSWORD}"
#   password: "${PROD_REDIS_PASSWORD:-fallback_secret}"
# ==========================================

# Redis Authentication Passwords
LOCAL_REDIS_PASSWORD=
DEV_REDIS_PASSWORD=
UAT_REDIS_PASSWORD=
PROD_REDIS_PASSWORD=

# Optional custom Redis ports or hosts
# DEV_REDIS_HOST=127.0.0.1
# PROD_REDIS_HOST=redis.prod.internal
